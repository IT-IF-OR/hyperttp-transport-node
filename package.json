{
  "name": "@hyperttp/transport-node",
  "version": "0.1.2",
  "description": "Native Node.js HTTP/1.1 and HTTP/2 transport for Hyperttp",
  "keywords": [
    "fetch",
    "http",
    "hyperttp",
    "node",
    "transport",
    "typescript"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-node.git"
  },
  "homepage": "https://github.com/IT-IF-OR/hyperttp-transport-node#readme",
  "bugs": {
    "url": "https://github.com/IT-IF-OR/hyperttp-transport-node/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./fetch": {
      "types": "./fetch.d.ts",
      "import": "./fetch.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.5",
    "@types/node": ">=20"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "private": false
}